import java.util.Scanner;

public class Main {
    static final int MAX_HEALTH = 100;
    static final double CRIT_CHANCE = 0.25;

    static final int ROWS = 5;
    static final int COLS = 11;

    public static void main(String[] args) {
        Scanner in = new Scanner(System.in);

        System.out.println("Hello!");
        System.out.println("Welcome to my game.");
        System.out.println("This is my arena.");
        System.out.println("");

        System.out.print("What is your name, challenger? ");
        String playerName = in.nextLine().trim();

        if (playerName.isEmpty()) {
            playerName = "Fighter";
        }

        int difficulty;

        do {
            System.out.print("Difficulty (1 = easy, 2 = normal, 3 = brutal): ");

            while (!in.hasNextInt()) {
                System.out.print("Numbers only. Try again: ");
                in.next();
            }

            difficulty = in.nextInt();
        } while (difficulty < 1 || difficulty > 3);

        in.nextLine();

        String difficultyName = switch (difficulty) {
            case 1 -> "Easy";
            case 2 -> "Normal";
            case 3 -> "Brutal";
            default -> "Unknown";
        };

        int playerHealth = MAX_HEALTH;
        double playerSpeed = 7.5;
        boolean isAlive = true;

        String opponentName = "Shadow";
        int opponentHealth = 40 * difficulty;
        int opponentPower = 5 + (difficulty * 5);

        String[] pack = {"Potion", "Bomb", "Shield"};
        int[] quantities = {2, 1, 0};
        int slots = 3;

        char[][] arena = new char[ROWS][COLS];

        for (int row = 0; row < ROWS; row++) {
            for (int col = 0; col < COLS; col++) {
                if (row == 0 || row == ROWS - 1 ||
                    col == 0 || col == COLS - 1) {
                    arena[row][col] = '#';
                } else {
                    arena[row][col] = '.';
                }
            }
        }

        int playerRow = 2;
        int playerCol = 1;

        int opponentRow = 2;
        int opponentCol = 9;

        arena[playerRow][playerCol] = '@';
        arena[opponentRow][opponentCol] = 'X';

        System.out.printf("%n%s enters the arena to face %s!%n",
                playerName, opponentName);
        System.out.println("Difficulty: " + difficultyName);

        printInventory(pack, quantities, slots);

        System.out.print("Press Enter to begin...");
        in.nextLine();

        System.out.println("\n--- GET READY ---");

        for (int countdown = 3; countdown >= 1; countdown--) {
            System.out.println(countdown + "...");

            try {
                Thread.sleep(1000);
            } catch (InterruptedException e) {
                Thread.currentThread().interrupt();
            }
        }

        System.out.println("FIGHT!");

        int turnNumber = 1;
        boolean playing = true;

        while (playing) {
            System.out.println();
            System.out.println("--- TURN " + turnNumber + " ---");

            drawArena(arena);

            System.out.println("Player: " + playerName +
                    " (HP: " + playerHealth + "/" + MAX_HEALTH + ")");
            System.out.println("Speed: " + playerSpeed +
                    " | Alive: " + isAlive);
            System.out.println("Opponent: " + opponentName +
                    " (HP: " + opponentHealth +
                    " | Power: " + opponentPower + ")");

            printInventory(pack, quantities, slots);

            String healthStatus = playerHealth >= 50 ? "steady" : "faltering";
            System.out.println("Your health is " + healthStatus + ".");

            System.out.println();
            System.out.println("[L] Move Left  [R] Move Right  [A]ttack");
            System.out.println("[D]efend  [P]otion  [F]lee");
            System.out.print("Choose an action: ");

            String action = in.nextLine().trim().toUpperCase();

            switch (action) {
                case "L" -> {
                    int newCol = playerCol - 1;

                    if (newCol >= 0 &&
                        arena[playerRow][newCol] != '#' &&
                        arena[playerRow][newCol] != 'X') {

                        arena[playerRow][playerCol] = '.';
                        playerCol = newCol;
                        arena[playerRow][playerCol] = '@';

                        System.out.println("You move left.");
                    } else {
                        System.out.println("You cannot move there!");
                    }
                }

                case "R" -> {
                    int newCol = playerCol + 1;

                    if (newCol < COLS &&
                        arena[playerRow][newCol] != '#' &&
                        arena[playerRow][newCol] != 'X') {

                        arena[playerRow][playerCol] = '.';
                        playerCol = newCol;
                        arena[playerRow][playerCol] = '@';

                        System.out.println("You move right.");
                    } else {
                        System.out.println("You cannot move there!");
                    }
                }

                case "A" -> {
                    int distance = Math.abs(playerCol - opponentCol);

                    if (distance == 1 && playerRow == opponentRow) {
                        int roll = (turnNumber * 3) % 10 + 1;

                        if (roll >= 9) {
                            int playerDamage = opponentPower * 2;
                            System.out.printf(
                                    "Critical hit! You strike %s for %d damage!%n",
                                    opponentName,
                                    playerDamage
                            );
                            opponentHealth -= playerDamage;
                        } else if (roll >= 3) {
                            int playerDamage = opponentPower;
                            System.out.printf(
                                    "Solid hit! You strike %s for %d damage!%n",
                                    opponentName,
                                    playerDamage
                            );
                            opponentHealth -= playerDamage;
                        } else {
                            System.out.println("You miss!");
                        }
                    } else {
                        System.out.println("You are too far away to attack!");
                        System.out.println("Move next to " + opponentName + " first.");
                    }
                }

                case "D" -> {
                    System.out.println("You defend and recover 5 HP.");
                    playerHealth += 5;

                    if (playerHealth > MAX_HEALTH) {
                        playerHealth = MAX_HEALTH;
                    }
                }

                case "P" -> {
                    if (quantities[0] > 0) {
                        quantities[0]--;
                        playerHealth += 25;

                        if (playerHealth > MAX_HEALTH) {
                            playerHealth = MAX_HEALTH;
                        }

                        System.out.println("You use a potion and recover 25 HP.");
                    } else {
                        System.out.println("You have no potions.");
                    }
                }

                case "F" -> {
                    isAlive = false;
                }

                default -> {
                    System.out.println("You hesitate and stumble around!");
                }
            }

            if (isAlive &&
                opponentHealth > 0 &&
                !action.equals("F")) {

                int distance = Math.abs(playerCol - opponentCol);

                if (distance == 1 && playerRow == opponentRow) {
                    playerHealth -= opponentPower;
                    System.out.printf(
                            "%s strikes back for %d damage.%n",
                            opponentName,
                            opponentPower
                    );
                } else {
                    System.out.println(opponentName + " is too far away to attack.");
                }
            }

            if (playerHealth <= 0) {
                playerHealth = 0;
            }

            if (!isAlive) {
                System.out.println("\nYou fled the battle! You managed to escape with your life.");
                playing = false;
            } else if (opponentHealth <= 0) {
                arena[opponentRow][opponentCol] = '.';

                System.out.printf(
                        "\nVictory! You defeated %s in %d turns!%n",
                        opponentName,
                        turnNumber
                );

                playing = false;
            } else if (playerHealth <= 0) {
                System.out.printf(
                        "\nYou died in the arena on turn %d! The crowd jeers.%n",
                        turnNumber
                );

                playing = false;
            }

            turnNumber++;
        }

        System.out.println("\nGame Over.");
        in.close();
    }

    static void printInventory(String[] pack, int[] quantities, int slots) {
        System.out.println("\n--- PACK ---");

        for (int i = 0; i < slots; i++) {
            System.out.println(pack[i] + ": " + quantities[i]);
        }
    }

    static void drawArena(char[][] arena) {
        System.out.println("+-----------+");

        for (char[] row : arena) {
            System.out.print("|");

            for (char cell : row) {
                System.out.print(cell);
            }

            System.out.println("|");
        }

        System.out.println("+-----------+");
    }
}
